# 智能视频水印去除工具 - 配置文件模板
# ============================================================
# 使用说明：
# 1. 将此文件复制为 config.ini（放到“用户配置目录”中）
#    - 如不确定路径，可运行：
#      python -c "from app.config.config_manager import ConfigManager; print(ConfigManager.get_config_path())"
#    - Windows（默认）示例路径：
#      %USERPROFILE%\\AppData\\Local\\YourOrg\\VideoWatermarkRemover\\config.ini
#    - 也可使用脚本自动生成：
#      .\\scripts\\vwr.ps1 run -AutoFix
# 2. 根据需要修改配置项
# 3. 修改配置后需要重启应用程序才能生效
# 4. 如需恢复默认设置，删除“用户配置目录”中的 config.ini 后重启程序即可
# ============================================================

[Paths]
# FFmpeg可执行文件路径（如果FFmpeg在系统PATH中，使用"ffmpeg"即可）
ffmpeg_path = ffmpeg

# 默认模型存储目录（相对于项目根目录）
default_model_dir = ./models

# 最后使用的输入目录（程序会自动更新此选项）
last_input_dir =

# 最后使用的输出目录（程序会自动更新此选项）
last_output_dir =

[Processing]
# 默认输出文件后缀
default_output_suffix = _processed

# 是否自动开始处理（选项：yes/no）
auto_start_processing = no

# GPU加速设置（选项：auto/yes/no）
# auto: 自动检测并使用GPU（如果可用）
# yes: 强制使用GPU（如果不可用则报错）
# no: 仅使用CPU处理
gpu_acceleration = auto

# 默认检测敏感度（0.1-1.0，值越高检测越敏感）
default_detection_sensitivity = 0.5

# 默认修复方法（选项：auto/telea/navier_stokes）
default_inpainting_method = auto

# 是否保留音频（选项：yes/no）
preserve_audio = yes

# 输出质量（选项：low/medium/high）
output_quality = high

[Logging]
# 日志级别（选项：DEBUG/INFO/WARNING/ERROR/CRITICAL）
# DEBUG: 详细的调试信息
# INFO: 一般信息
# WARNING: 警告信息
# ERROR: 错误信息
# CRITICAL: 严重错误信息
log_level = INFO

# 日志文件路径（相对路径或绝对路径）
log_file_path = logs/app.log

# 是否在控制台显示日志（选项：yes/no）
console_logging = yes

# 日志文件最大大小（MB），超过后自动轮转
max_log_file_size = 10

# 保留的日志文件数量
log_file_backup_count = 5

[Models]
# 水印检测模型路径（可选，当前主检测链路默认使用 YOLO 配置）
detection_model_path =

# 图像修复模型路径（GPU 深度学习 U-Net 权重）
# 说明：
# - 仅在启用 GPU 深度学习修复时使用
# - 为空或文件不存在时，主流程会明确降级到 OpenCV 修复
# - 当前不会自动下载该权重，需要手动提供
inpainting_model_path =

# 默认置信度阈值（0.0-1.0）
default_confidence_threshold = 0.5

# 模型类型（选项：opencv/deep_learning）
# 说明：此项当前主要用于保留兼容信息，实际修复后端仍由运行时参数和权重可用性共同决定
model_type = opencv

[UI]
# 默认主题（选项：dark/light）
default_theme = dark

# 默认窗口大小
default_window_width = 1400
default_window_height = 900

# 是否在启动时最大化窗口（选项：yes/no）
start_maximized = no

# 是否记住窗口位置和大小（选项：yes/no）
remember_window_geometry = yes

[Advanced]
# 最大线程数（-1表示自动检测，0表示单线程，>0表示指定线程数）
max_threads = -1

# 缓存大小（MB）
cache_size_mb = 512

# 是否启用缓存（选项：yes/no）
enable_cache = yes

# 自动保存间隔（秒，0表示不自动保存）
auto_save_interval = 300

# 临时文件清理策略（选项：always/on_exit/manual）
temp_file_cleanup = on_exit

[Batch]
# 批量处理时的最大并发文件数
max_concurrent_files = 1

# 是否自动重试失败的文件（选项：yes/no）
auto_retry_failed = yes

# 失败重试次数
max_retry_count = 3

# 是否在处理完成后删除临时文件（选项：yes/no）
delete_temp_files = yes

# 是否显示详细的处理进度（选项：yes/no）
show_progress_details = yes

[YOLO]
# YOLO水印检测模型配置（Phase 6+）
#
# 模型类型选择（选项：yolo11s/yolo11x-watermark/yolo11x-watermark-corzent/custom）
# - yolo11s: 通用COCO模型（19MB，适合CPU，检测准确率~70-80%）
# - yolo11x-watermark: 专用水印模型（114MB，推荐GPU，检测准确率>99%）⭐ 推荐
# - yolo11x-watermark-corzent: corzent 微调版本（约109MB，MIT许可，适合对比验证/特定场景增强）
# - custom: 使用自定义模型路径
  model_type = yolo11x-watermark

# 自定义模型路径（仅当model_type=custom时使用）
custom_model_path =

# YOLO置信度阈值（0.0-1.0）
# 说明：专用水印模型可使用较低阈值（0.25），通用模型建议0.5
conf_threshold = 0.25

# IoU阈值（0.0-1.0）用于非极大值抑制（NMS）
# 说明：控制重叠检测框的合并，值越高保留越多框
iou_threshold = 0.45

# 批处理大小（针对GPU优化）
# 说明：0=自动检测，1=单帧处理，8-16=批处理
# 推荐：NVIDIA 4070 Ti Super (16GB)使用8-12获得最佳性能
batch_size = 8

# 是否自动下载缺失的模型（选项：yes/no）
# 说明：首次使用时自动从Hugging Face下载模型（约114MB）
auto_download_model = yes

# 模型下载源（选项：huggingface/github）
# huggingface: fancyfeast/joycaption-watermark-detection
# github: ultralytics官方仓库
model_download_source = huggingface

# ==================== 掩码精修（解决边界不准） ====================
# 说明：当前水印模型多为检测框输出（boxes），需要 bbox→mask 生成修复区域。
# 下面参数用于减少“偏移/过大/过小”等边界问题，可按素材类型微调。
#
# bbox→mask 自适应 padding（像素 + 比例）
mask_padding_px = 4
mask_padding_ratio = 0.02
mask_padding_max = 24
#
# 掩码后处理：腐蚀/膨胀迭代次数（0=关闭；增大可分别收缩/扩大掩码）
mask_erode_iterations = 0
mask_dilate_iterations = 0
#
# 闭运算 kernel（奇数，0=关闭）：连接近邻区域、填补小孔洞
mask_close_kernel = 5
