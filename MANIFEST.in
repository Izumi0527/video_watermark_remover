# 智能视频水印去除工具 - 发布清单（sdist）
# 目标：
# - 只包含发布/运行所需的最小集合
# - 避免引用不存在文件导致打包失败
# - 避免将大体积模型与运行产物打包进发布物

include pyproject.toml
include README.md
include requirements.txt
include requirements-dev.txt
include config.ini.example
include LICENSE
include main.py

# 入口脚本（Windows PowerShell）
include scripts/README.md
recursive-include scripts *.ps1 *.md

# 应用代码与资源
recursive-include src/app *.py
recursive-include src/app/assets *

# 文档
recursive-include docs *.md

# 测试（仅代码与必要样例文件；避免引入大文件）
recursive-include tests *.py *.ps1 *.md *.ini *.yaml *.yml *.json

# 额外说明文件
include models/README.md
exclude models/*.pt

# 排除运行产物/缓存
global-exclude __pycache__ *.py[cod] *.log *.tmp
prune .git
prune .venv
prune venv
prune env
prune logs
prune .pytest_cache
prune .mypy_cache
prune .vscode
prune .idea
